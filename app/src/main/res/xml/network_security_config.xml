<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：允许明文 HTTP。

  本应用的 K 线数据源 Aktie_datasource 为局域网自建服务（v1 无 TLS，
  服务器 IP 由设置页手工配置，可能为任意内网地址），必须走明文 http；
  其余外部请求（成员搜索联想等）本身即 https，不受影响。
  若将来数据源上 TLS 或暴露公网，应收紧此配置。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
