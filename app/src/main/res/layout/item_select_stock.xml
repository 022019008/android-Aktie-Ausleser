<?xml version="1.0" encoding="utf-8"?>
<lv.bingping.ausleser.ui.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 内容层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tv_stock_code"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_stock_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_stock_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quote_placeholder"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 操作层：默认排在右边缘之外（被裁剪隐藏），左滑才出现 -->
    <LinearLayout
        android:id="@+id/row_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_sync_stock"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_action_sync"
            android:contentDescription="@string/action_sync"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sync"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btn_delete_stock"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_action_delete"
            android:contentDescription="@string/action_delete"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="@color/white" />
    </LinearLayout>
</lv.bingping.ausleser.ui.SwipeRevealLayout>
