<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <!-- 第一层：顶部工具栏：标题 Ausleser 右侧紧贴“自选”按钮，最右侧为服务器设置入口 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="@string/app_name"
            app:titleTextColor="?attr/colorOnPrimary">

            <!-- “自选”按钮：紧贴标题右侧，点击后展开/收起下方子栏 -->
            <Button
                android:id="@+id/btn_selber_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:text="@string/selber_select" />

            <!-- 服务器设置入口：顶栏最右侧齿轮 -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_action"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnPrimary" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- 第二层：顶部工具栏子栏（默认隐藏，点击“自选”后显示全部自选分组，可横向滑动；右侧“群组管理”用于增删改分组） -->
        <LinearLayout
            android:id="@+id/sub_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/group_chip_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <Button
                android:id="@+id/btn_group_manage"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:text="@string/group_manage" />

            <ImageButton
                android:id="@+id/btn_sync_group"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sync_group_action"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sync"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 第三层工具栏 + 当前分组的自选列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 第三层工具栏：左侧当前分组名，右侧“+”添加自选 -->
        <LinearLayout
            android:id="@+id/stocks_toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/colorSurface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tv_stocks_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="18sp"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_add_stock"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:contentDescription="@string/add_stock_action"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stocks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tv_stocks_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/empty_stocks"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
